# MYSQL SETUP
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
# MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD -> provided via Docker secrets, see secrets/ below

# WORDPRESS SETUP
DOMAIN_NAME=mgarnier.42.fr
WP_TITLE=Inception
WP_ADMIN=mgarnier
# WP_ADMIN_PASSWORD -> provided via Docker secrets, see secrets/wp_admin_password.txt below
WP_ADMIN_EMAIL=admin@example.com
WP_USER=editor
# WP_USER_PASSWORD -> provided via Docker secrets, see secrets/wp_user_password.txt below
WP_USER_EMAIL=editor@example.com

# ---
# This is a template: copy to .env and fill in real values.
# cp srcs/.env.example srcs/.env
#
# The Alpine base image is pinned directly in srcs/docker-compose.yml (not
# here), on purpose: it must be identical and immutable for every developer
# and for grading, so it lives in a tracked file rather than in this
# git-ignored one.
#
# Passwords are NOT set here — they live in git-ignored files under secrets/:
#   secrets/db_password.txt        -> MariaDB wpuser password
#   secrets/db_root_password.txt   -> MariaDB root password
#   secrets/wp_admin_password.txt  -> WordPress admin password
#   secrets/wp_user_password.txt   -> WordPress second (non-admin) user password
# Create these four files locally (one password per file, no trailing content)
# before running `docker compose up`.
