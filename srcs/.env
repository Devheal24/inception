### MYSQL SETUP ###
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
# MYSQL_PASSWORD=add in ./secrets/db_password.txt
# MYSQL_ROOT_PASSWORD=add in ./secrets/db_root_password.txt



### WORDPRESS SETUP ###
DOMAIN_NAME=${USER}.42.fr
WP_TITLE=Inception

# ADMIN
WP_ADMIN=${USER}
WP_ADMIN_EMAIL=${USER}42@example.com
# WP_ADMIN_PASSWORD=add in ./secrets/wp_admin_password.txt

# USER
WP_USER=editor
WP_USER_EMAIL=editor@example.com
# WP_USER_PASSWORD=add in ./secrets/wp_user_password.txt
